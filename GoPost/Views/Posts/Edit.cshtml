@model GoPost.Models.Post
@using Microsoft.AspNetCore.Identity  // Add this using statement
@inject UserManager<ApplicationUser> UserManager  // Inject UserManager
@{
    ViewData["Title"] = "Edit Post";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="ImagePath" />

    <div class="form-group mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Content" class="form-label"></label>
        <textarea asp-for="Content" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label class="form-label">Change Image (optional)</label>
        <input type="file" name="ImageFile" class="form-control" />
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
                <div class="mt-2">
                    <p>Current Image:</p>
                    <img src="@Url.Content(Model.ImagePath)" alt="Current Image" class="img-thumbnail" style="max-height: 150px;" />
                </div>
        }
    </div>

    <div class="form-group mb-3">
        <label class="form-label">Change Files (optional)</label>
        <input type="file" name="newFiles" class="form-control" multiple />

        @if (Model.PostFiles != null && Model.PostFiles.Any())
        {
                <div class="mt-2">
                    <h5>Current Files:</h5>
                    <ul>
                    @foreach (var file in Model.PostFiles)
                    {
                            <li id="file-@file.Id" class="file-item">
                                <a href="@Url.Content(file.FilePath)" target="_blank">@file.FileName</a>
                                <button type="button" class="btn btn-danger btn-sm remove-file-btn" data-file-id="@file.Id" style="margin-left: 10px;">
                                    <i class="bi bi-x-circle"></i> Remove
                                </button>
                            </li>
                    }
                    </ul>
                </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">💾 Save Changes</button>
    @{
        string currentUserId = UserManager.GetUserId(User);
    }
    <a asp-controller="Profiles" asp-action="Profile" asp-route-userId="@currentUserId">Back to Profile</a>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial");

            <script>
                // Attach click event for the remove file button
                $(".remove-file-btn").click(function (e) {
                    e.preventDefault();
                    var fileId = $(this).data("file-id");
                    var fileContainer = $("#file-" + fileId);

                    // AJAX call to remove the file
                    $.ajax({
                        url: '@Url.Action("RemoveFile", "Posts")',  // Make sure this is the correct controller and action
                        type: 'POST',
                        data: {
                            fileId: fileId
                        },
                        success: function (response) {
                            if (response.success) {
                                // On success, remove the file element from the DOM
                                fileContainer.remove();
                            } else {
                                alert("Error removing the file.");
                            }
                        },
                        error: function () {
                            alert("An error occurred while removing the file.");
                        }
                    });
                });
            </script>
}
