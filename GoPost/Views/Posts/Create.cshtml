@model GoPost.Models.Post

@{
    ViewData["Title"] = "Create Post";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-gradient text-white p-3" style="background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);">
                    <h2 class="mb-0 fs-3"><i class="bi bi-pencil-square me-2"></i>Create New Post</h2>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data" id="createPostForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger rounded-3 p-3 mb-3" style="background-color: rgba(220, 53, 69, 0.1);"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-medium">Title</label>
                            <input asp-for="Title" class="form-control form-control-lg shadow-sm" placeholder="Enter a descriptive title" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label fw-medium">Content</label>
                            <textarea asp-for="Content" class="form-control shadow-sm" rows="6" placeholder="Write your post content here..."></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium"><i class="bi bi-image me-1"></i>Add Image</label>
                            <input type="file" name="imageFile" class="form-control shadow-sm" accept="image/*" id="imageUpload" />
                            <div id="imagePreview" class="mt-2 d-none">
                                <img src="#" alt="Image Preview" class="img-fluid rounded" style="max-height: 200px" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-medium"><i class="bi bi-paperclip me-1"></i>Attach Files</label>
                            <input type="file" name="fileAttachments" class="form-control shadow-sm" multiple id="fileUpload" />
                            <div id="fileList" class="mt-2 small text-muted"></div>
                        </div>
    
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary me-md-2">
                                <i class="bi bi-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2">
                                <i class="bi bi-send me-1"></i>Publish Post
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.Partial("_ValidationScriptsPartial")
    <script>
        $(document).ready(function() {
            // Image preview functionality
            $("#imageUpload").change(function() {
                if (this.files && this.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        $('#imagePreview img').attr('src', e.target.result);
                        $('#imagePreview').removeClass('d-none');
                    }
                    reader.readAsDataURL(this.files[0]);
                } else {
                    $('#imagePreview').addClass('d-none');
                }
            });

            // File list preview
            $("#fileUpload").change(function() {
                const fileList = $('#fileList');
                fileList.empty();
                
                if (this.files && this.files.length > 0) {
                    fileList.append('<p class="mb-1">Selected files:</p>');
                    const list = $('<ul class="ps-3 mb-0"></ul>');
                    
                    for (let i = 0; i < this.files.length; i++) {
                        list.append(`<li>${this.files[i].name}</li>`);
                    }
                    fileList.append(list);
                }
            });
        });
    </script>
}

