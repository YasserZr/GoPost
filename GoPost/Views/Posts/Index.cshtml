@model IEnumerable<GoPost.Models.Post>

@{
    ViewData["Title"] = "My Posts";
}

<h1 class="mb-4">My Posts</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">➕ Create New Post</a>
</p>

<!-- 🔍 AJAX Search Input -->
<div class="mb-3">
    <input type="text" id="searchInput" class="form-control" placeholder="🔍 Search by title..." />
</div>

<!-- 🔁 Dynamic Table Container -->
<div id="postsContainer">
    @Html.Partial("_PostsTable", Model)
</div>

@section Scripts {
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script>
            $(document).ready(function () {
                $("#searchInput").on("input", function () {
                    const searchValue = $(this).val();

                    $.ajax({
                        url: '@Url.Action("Search", "Posts")',
                        data: { searchString: searchValue },
                        success: function (result) {
                            $("#postsContainer").html(result);
                        },
                        error: function () {
                            $("#postsContainer").html('<p class="text-danger">Something went wrong while searching.</p>');
                        }
                    });
                });
            });
        </script>
}
