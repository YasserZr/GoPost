@model GoPost.Models.Post
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Delete Post";
    string currentUserId = UserManager.GetUserId(User);
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-danger text-white py-3">
                    <h2 class="card-title mb-0 fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Post
                    </h2>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning mb-4" role="alert">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        <strong>Warning:</strong> This action cannot be undone. Are you sure you want to delete this post?
                    </div>
                    
                    <div class="post-preview mb-4 p-3 bg-light rounded-3">
                        <h5 class="border-bottom pb-2 mb-3">Post Content</h5>
                        <p>@Model.Content</p>
                        
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div class="text-center mt-3">
                                <img src="@Url.Content(Model.ImagePath)" alt="Post Image" class="img-fluid rounded mb-3" style="max-height: 200px;" />
                            </div>
                        }
                        
                        <div class="mt-3 text-muted small">
                            <div><strong>Posted by:</strong> @Model.User?.UserName</div>
                            <div><strong>Date:</strong> @Model.CreatedAt.ToString("MMM d, yyyy h:mm tt")</div>
                            
                            @if (Model.PostFiles != null && Model.PostFiles.Any())
                            {
                                <div class="mt-2">
                                    <strong>Attached Files:</strong> @Model.PostFiles.Count()
                                </div>
                            }
                        </div>
                    </div>
                    
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash-fill me-2"></i>Delete Permanently
                            </button>
                            <a asp-controller="Profiles" asp-action="Profile" asp-route-userId="@currentUserId" 
                               class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Back to Profile
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
