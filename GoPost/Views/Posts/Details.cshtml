@model GoPost.Models.Post

@{
    ViewData["Title"] = "Post Details";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h3 class="card-title">@Model.Title</h3>
            <h6 class="text-muted">Posted by: @Model.User?.UserName</h6>
            <p class="card-text mt-2">@Model.Content</p>

            @* Display image if uploaded *@
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                    <div class="mt-3">
                        <img src="@Url.Content(Model.ImagePath)" alt="Post Image" class="img-fluid rounded" style="max-height: 400px;" />
                    </div>
            }

            @* Show individual files as links *@
            <div class="mt-2">
                @foreach (var file in Model.PostFiles)
                {
                        <a class="btn btn-outline-secondary btn-sm mb-1" href="@file.FilePath" download>
                            📎 @file.FileName
                        </a>
                        <br />
                }
            </div>

            <small class="text-muted d-block mt-3">Created at: @Model.CreatedAt.ToLocalTime()</small>

            <div class="mt-3">
                <button id="likeButton" class="btn btn-outline-primary btn-sm" onclick="likePost(@Model.Id)">
                    👍 <span id="likeCount">@Model.Reactions?.Count(r => r.Type == "like")</span>
                </button>
            </div>
        </div>
    </div>

    <hr />

    <h5 class="mt-4">Comments (@Model.Comments?.Count())</h5>

    <div id="commentsList">
        @if (Model.Comments != null && Model.Comments.Any())
        {
                <ul class="list-group">
                @foreach (var comment in Model.Comments)
                {
                            <li class="list-group-item">
                                <strong>@comment.User?.UserName</strong>: @comment.Content
                                <br />
                                <small class="text-muted">@comment.CreatedAt.ToLocalTime()</small>
                            </li>
                }
                </ul>
        }
        else
        {
                <p class="text-muted">No comments yet.</p>
        }
    </div>

    <hr />

    <h5>Add a Comment</h5>

    <form id="commentForm" method="post">
        <input type="hidden" name="PostId" value="@Model.Id" />
        <div class="mb-3">
            <textarea id="commentContent" name="Content" class="form-control" rows="3" placeholder="Write your comment here..." required></textarea>
        </div>
        <button type="submit" class="btn btn-success">Comment</button>
    </form>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

@section Scripts {
        <script>
            // Function to handle the like button click
            async function likePost(postId) {
                const likeButton = document.getElementById("likeButton");
                const likeCountElement = document.getElementById("likeCount");

                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                const response = await fetch(`/Reactions/Like`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: `postId=${postId}&__RequestVerificationToken=${token}`
                });

                if (response.ok) {
                    const newLikeCount = await response.json();
                    likeCountElement.textContent = newLikeCount;
                } else {
                    alert("Something went wrong. Please try again.");
                }
            }

            // Comment form AJAX (previously added)
            document.getElementById("commentForm").addEventListener("submit", async function (e) {
                e.preventDefault();

                const postId = document.querySelector('input[name="PostId"]').value;
                const content = document.getElementById("commentContent").value.trim();

                if (!content) {
                    alert("Comment cannot be empty.");
                    return;
                }

                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                const response = await fetch(`/Comments/Create`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: `postId=${postId}&content=${encodeURIComponent(content)}&__RequestVerificationToken=${token}`
                });

                if (response.ok) {
                    const updatedComments = await response.text();
                    document.getElementById("commentsList").innerHTML = updatedComments;
                    document.getElementById("commentContent").value = "";
                } else {
                    alert("Something went wrong. Please try again.");
                }
            });
        </script>
}
