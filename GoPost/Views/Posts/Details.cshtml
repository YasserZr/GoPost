@model GoPost.Models.Post

@{
    ViewData["Title"] = "Post Details";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isLiked = Model.IsLikedBy(currentUserId);
}

<div class="container py-4">
    <div class="card shadow border-0 rounded-3 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <img src="@(Model.User?.ProfileImageUrl ?? "/images/default-profile.png")" 
                     class="rounded-circle me-3" width="48" height="48" alt="Profile" />
                <div>
                    <h5 class="mb-0 fw-bold">@Model.Title</h5>
                    <div class="text-muted small">
                        Posted by 
                        <a href="@Url.Action("Profile", "Profiles", new { userId = @Model.User?.Id })" class="fw-medium text-decoration-none">
                            @Model.User?.UserName
                        </a>
                        <span class="ms-2"><i class="bi bi-clock"></i> @Model.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <p class="card-text lead mb-4">@Model.Content</p>

            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="text-center mb-4">
                    <img src="@Url.Content(Model.ImagePath)" alt="Post Image" class="img-fluid rounded shadow-sm" style="max-height: 500px;" />
                </div>
            }

            @if (Model.PostFiles != null && Model.PostFiles.Any())
            {
                <div class="mb-4">
                    <h6 class="mb-3"><i class="bi bi-paperclip me-2"></i>Attachments</h6>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var file in Model.PostFiles)
                        {
                            <a class="btn btn-light border-secondary text-start d-flex align-items-center" href="@file.FilePath" download>
                                <i class="bi bi-file-earmark me-2"></i>
                                <span>@file.FileName</span>
                            </a>
                        }
                    </div>
                </div>
            }

            <div class="d-flex align-items-center mt-4">
                <button id="likeButton" class="btn @(isLiked ? "btn-primary" : "btn-outline-primary") rounded-pill px-4" onclick="likePost(@Model.Id)">
                    <i class="bi @(isLiked ? "bi-hand-thumbs-up-fill" : "bi-hand-thumbs-up")"></i> 
                    <span id="likeText" class="ms-1">@(isLiked ? "Liked" : "Like")</span> 
                    <span id="likeCount" class="badge bg-white @(isLiked ? "text-primary" : "text-secondary") ms-1">
                        @Model.Reactions?.Count(r => r.Type == "like")
                    </span>
                </button>
                <a href="#commentSection" class="btn btn-outline-secondary rounded-pill px-4 ms-2">
                    <i class="bi bi-chat-dots"></i>
                    <span class="ms-1">Comment</span>
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 ms-auto">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
            </div>
        </div>
    </div>

    <div id="commentSection" class="card border-0 shadow rounded-3">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0"><i class="bi bi-chat-square-text me-2"></i>Comments (@Model.Comments?.Count())</h5>
        </div>
        
        <div class="card-body p-4">
            <form id="commentForm" method="post" class="mb-4">
                <input type="hidden" name="PostId" value="@Model.Id" />
                <div class="mb-3">
                    <textarea id="commentContent" name="Content" class="form-control border-0 bg-light shadow-sm" 
                              rows="3" placeholder="Write your comment here..." required></textarea>
                </div>
                <div class="text-end">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-send me-2"></i>Post Comment
                    </button>
                </div>
            </form>

            <div id="commentsList" class="mt-4">
                @if (Model.Comments != null && Model.Comments.Any())
                {
                    <div class="list-group list-group-flush rounded-3">
                        @foreach (var comment in Model.Comments)
                        {
                            <div class="list-group-item border-0 border-bottom py-4">
                                <div class="d-flex">
                                    <img src="@(comment.User?.ProfileImageUrl ?? "/images/default-profile.png")" 
                                         class="rounded-circle me-3" width="40" height="40" alt="Profile" />
                                    <div>
                                        <div class="d-flex align-items-center">
                                            <a href="@Url.Action("Profile", "Profiles", new { userId = @comment.User?.Id })" 
                                               class="fw-bold text-decoration-none">@comment.User?.UserName</a>
                                            <span class="text-muted ms-3 small">
                                                <i class="bi bi-clock me-1"></i>
                                                @comment.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                            </span>
                                        </div>
                                        <p class="mt-2 mb-0">@comment.Content</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-chat-square text-muted" style="font-size: 3rem;"></i>
                        <h6 class="mt-3 text-muted">No comments yet</h6>
                        <p class="text-muted small">Be the first to share your thoughts!</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Function to handle the like button click
        async function likePost(postId) {
            const likeButton = document.getElementById("likeButton");
            const likeTextElement = document.getElementById("likeText");
            const likeCountElement = document.getElementById("likeCount");
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const response = await fetch(`/Reactions/Like`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `postId=${postId}&__RequestVerificationToken=${token}`
            });

            if (response.ok) {
                const data = await response.json();
                likeCountElement.textContent = data.likeCount;
                likeTextElement.textContent = data.isLiked ? "Liked" : "Like";
                likeButton.classList.toggle('btn-outline-primary', !data.isLiked);
                likeButton.classList.toggle('btn-primary', data.isLiked);
            } else {
                alert("Something went wrong. Please try again.");
            }
        }

        document.getElementById("commentForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const postId = document.querySelector('input[name="PostId"]').value;
            const content = document.getElementById("commentContent").value.trim();

            if (!content) {
                alert("Comment cannot be empty.");
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            const response = await fetch(`/Comments/Create`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `postId=${postId}&content=${encodeURIComponent(content)}&__RequestVerificationToken=${token}`
            });

            if (response.ok) {
                const comment = await response.json(); // Expect the new comment object

                // Create the HTML for the new comment
                const newCommentHtml = `
                    <li class="list-group-item">
                        <strong>${comment.userName}</strong>: ${comment.content}
                        <br />
                        <small class="text-muted">${new Date(comment.createdAt).toLocaleString()}</small>
                    </li>
                `;

                // Append the new comment to the list
                const commentsList = document.getElementById("commentsList").querySelector(".list-group");
                if (commentsList) {
                    commentsList.appendChild(new DOMParser().parseFromString(newCommentHtml, 'text/html').body.firstChild);
                } else {
                    // If there were no comments before, create the ul element
                    const newUl = document.createElement('ul');
                    newUl.className = 'list-group';
                    newUl.innerHTML = newCommentHtml;
                    document.getElementById("commentsList").innerHTML = ''; // Clear "No comments yet."
                    document.getElementById("commentsList").appendChild(newUl);
                }

                // Update the comment count in the heading
                const commentCountElement = document.querySelector('h5.mb-0');
                if (commentCountElement) {
                    const currentCount = parseInt(commentCountElement.textContent.match(/\((\d+)\)/)?.[1] || '0');
                    commentCountElement.textContent = `Comments (${currentCount + 1})`;
                }

                document.getElementById("commentContent").value = "";
            } else {
                alert("Something went wrong. Please try again.");
            }
        });
    </script>
}