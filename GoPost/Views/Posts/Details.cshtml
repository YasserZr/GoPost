@model GoPost.Models.Post

@{
	ViewData["Title"] = "Post Details";
}

<div class="container mt-4">
	<div class="card shadow-sm">
		<div class="card-body">
			<h3 class="card-title">@Model.Title</h3>
			<h6 class="text-muted">Posted by: @Model.User?.UserName</h6>
			<p class="card-text mt-2">@Model.Content</p>

			@* Display image if uploaded *@
			@if (!string.IsNullOrEmpty(Model.ImagePath))
			{
						<div class="mt-3">
							<img src="@Url.Content(Model.ImagePath)" alt="Post Image" class="img-fluid rounded" style="max-height: 400px;" />
						</div>
			}

				@* Show individual files as links *@
			<div class="mt-2">
					@foreach (var file in Model.PostFiles)
					{
							<a class="btn btn-outline-secondary btn-sm mb-1" href="@file.FilePath" download>
								📎 @file.FileName
							</a>

								<br />
					}
			</div>


			<small class="text-muted d-block mt-3">Created at: @Model.CreatedAt.ToLocalTime()</small>

			<div class="mt-3">
				<form asp-controller="Reactions" asp-action="Like" method="post" class="d-inline">
					<input type="hidden" name="postId" value="@Model.Id" />
					<button type="submit" class="btn btn-outline-primary btn-sm">
						👍 @Model.Reactions?.Count(r => r.Type == "like") ?? 0
					</button>
				</form>
			</div>
		</div>
	</div>

	<hr />

	<h5 class="mt-4">Comments (@Model.Comments?.Count() ?? 0)</h5>

	@if (Model.Comments != null && Model.Comments.Any())
	{
				<ul class="list-group">
			@foreach (var comment in Model.Comments)
			{
								<li class="list-group-item">
									<strong>@comment.User?.UserName</strong>: @comment.Content
									<br />
									<small class="text-muted">@comment.CreatedAt.ToLocalTime()</small>
								</li>
			}
				</ul>
	}
	else
	{
				<p class="text-muted">No comments yet.</p>
	}

	<hr />

	<h5>Add a Comment</h5>

	<form asp-controller="Comments" asp-action="Create" method="post">
		<input type="hidden" name="PostId" value="@Model.Id" />
		<div class="mb-3">
			<textarea name="Content" class="form-control" rows="3" placeholder="Write your comment here..." required></textarea>
		</div>
		<button type="submit" class="btn btn-success">Comment</button>
	</form>

	<div class="mt-3">
		<a asp-action="Index" class="btn btn-secondary">Back to List</a>
	</div>
</div>
