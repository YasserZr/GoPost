@model List<GoPost.Models.ViewModels.UserProfileViewModel>

@{
    ViewData["Title"] = "Search Results";
}

<div class="container py-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-gradient d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-search me-2"></i>Search Results</h5>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-x text-muted" style="font-size: 3rem;"></i>
                    <h6 class="mt-3 text-muted">No users found</h6>
                    <p class="text-muted small">Try searching with different keywords</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary mt-2">
                        <i class="bi bi-arrow-left me-2"></i>Return Home
                    </a>
                </div>
            }
            else
            {
                <div class="list-group">
                    @foreach (var user in Model)
                    {
                        <div class="list-group-item list-group-item-action d-flex align-items-center p-3 border-0 border-bottom">
                            <img src="@(user.ProfileImageUrl ?? "/defaults/images/default-avatar.png")" alt="@user.UserName's profile" 
                                 class="rounded-circle me-3" width="50" height="50" />
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0 fw-medium">@user.UserName</h6>
                                    <a asp-controller="Profiles" asp-action="Profile" asp-route-userId="@user.Id" 
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-person-badge me-1"></i>View Profile
                                    </a>
                                </div>
                                <p class="mb-0 small text-muted">@user.Email</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
