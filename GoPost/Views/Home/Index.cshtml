@model GoPost.Models.ViewModels.HomePageViewModel
@{
    ViewData["Title"] = "Home Page";
}

@if (User.Identity.IsAuthenticated)
{
    <div class="container py-4">
        <!-- People you may know section -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-gradient d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-people me-2"></i>People you may know</h5>
            </div>
            <div class="card-body position-relative">
                <button id="suggestion-scroll-left" class="btn btn-sm btn-light rounded-circle position-absolute start-0 top-50 translate-middle-y" style="z-index: 1; width: 32px; height: 32px;">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <div id="suggestion-container" class="d-flex overflow-hidden px-3" style="max-width: 100%; scroll-behavior: smooth;">
                    <ul id="suggestionList" class="list-unstyled d-flex flex-nowrap" style="padding-left: 0; margin-bottom: 0; transition: transform 0.3s ease-in-out;">
                    @foreach (var user in Model.SuggestedUsers)
                    {
                        <li id="user-@user.Id" class="me-3 flex-shrink-0" style="width: 200px;">
                            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all">
                                <div class="card-body text-center p-3">
                                        <img src="@(user.ProfileImageUrl ?? "defaults/images/default-avatar.png")" alt="Profile" class="rounded-circle mb-3 border shadow-sm" width="64" height="64" />
                                    <h6 class="card-title mb-2">
                                        <a href="@Url.Action("Profile", "Profiles", new { userId = user.Id })" class="text-decoration-none">
                                            @user.UserName
                                        </a>
                                    </h6>
                                    <button class="btn btn-primary btn-sm w-100 follow-btn" data-user-id="@user.Id">
                                        <i class="bi bi-person-plus me-1"></i>Follow
                                    </button>
                                </div>
                            </div>
                        </li>
                    }
                    </ul>
                </div>
                <button id="suggestion-scroll-right" class="btn btn-sm btn-light rounded-circle position-absolute end-0 top-50 translate-middle-y" style="z-index: 1; width: 32px; height: 32px;">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
        
        <!-- Create post button -->
        <div class="d-grid mb-4">
            <a asp-controller="Posts" asp-action="Create" class="btn btn-primary btn-lg shadow">
                <i class="bi bi-plus-circle me-2"></i>Create New Post
            </a>
        </div>
        
        <!-- Recent Posts from Following -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-gradient d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-collection me-2"></i>Recent Posts from Following</h5>
            </div>
            <div class="card-body p-0">
                <ul id="followingPostsList" class="list-group list-group-flush">
                @if (Model.FollowingPosts.Any())
                {
                    @foreach (var post in Model.FollowingPosts)
                    {
                        <li class="list-group-item p-0 post-item" data-post-id="@post.Id">
                            <div class="card border-0">
                                <div class="card-header bg-transparent d-flex align-items-center py-3">
                                        <img src="@(post.User.ProfileImageUrl ?? "defaults/images/default-avatar.png")" class="rounded-circle me-2" width="40" height="40" alt="@post.User.UserName's profile">
                                    <div>
                                        <div class="fw-bold text-primary">@post.User.UserName</div>
                                        <div class="text-muted small"><i class="bi bi-clock me-1"></i>@post.CreatedAt.ToString("g")</div>
                                    </div>
                                </div>
                                <div class="card-body py-3">
                                    <h5 class="card-title mb-2">@post.Title</h5>
                                    <p class="card-text">@post.Content</p>
                                    @if (!string.IsNullOrEmpty(post.ImagePath))
                                    {
                                        <div class="post-image mt-2">
                                            <img src="@post.ImagePath" alt="Post Image" class="img-fluid rounded">
                                        </div>
                                    }
                                        @if (post.PostFiles != null && post.PostFiles.Any())
                                    {
                                        <div class="mt-2 d-flex align-items-center">
                                            <i class="bi bi-paperclip text-muted me-1"></i>
                                                <span class="text-muted small">This post has @post.PostFiles.Count file@(post.PostFiles.Count != 1 ? "s" : "")</span>
                                        </div>
                                    }
                                </div>
                                <div class="card-footer bg-transparent d-flex justify-content-between py-3">
                                    <div class="d-flex align-items-center">
                                        <button class="btn btn-sm btn-outline-secondary me-3 d-flex align-items-center comment-btn" data-post-id="@post.Id" disabled>
                                            <i class="bi bi-chat-dots me-1"></i> 
                                            <span class="comment-count" data-post-id="@post.Id">0</span>
                                                
                                        </button>
                                            <button class="btn btn-sm btn-outline-danger d-flex align-items-center like-btn" data-post-id="@post.Id" disabled>
                                            <i class="bi bi-heart me-1"></i> 
                                            <span class="like-count" data-post-id="@post.Id">0</span>
                                                
                                        </button>
                                    </div>
                                    <button class="btn btn-sm btn-outline-primary view-details-btn">
                                        <i class="bi bi-eye me-1"></i> View Details
                                    </button>
                                </div>
                                <div class="comments-section px-4 py-3 bg-light border-top" id="comments-@post.Id" style="display: none;">
                                </div>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-center py-4">
                        <i class="bi bi-inbox text-muted d-block mb-2" style="font-size: 2rem;"></i>
                        <p class="text-muted mb-0">No recent posts from the users you are following.</p>
                    </li>
                }
                </ul>
            </div>
        </div>

        <!-- Your Recent Posts -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-gradient d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-journal-text me-2"></i>Your Recent Posts</h5>
            </div>
            <div class="card-body p-0">
                <ul id="currentUserPostsList" class="list-group list-group-flush">
                @if (Model.CurrentUserPosts.Any())
                {
                    @foreach (var post in Model.CurrentUserPosts)
                    {
                        <li class="list-group-item p-0 post-item" data-post-id="@post.Id">
                            <div class="card border-0">
                                <div class="card-header bg-transparent d-flex align-items-center py-3">
                                    <img src="@(post.User.ProfileImageUrl ?? "/images/default-avatar.png")" class="rounded-circle me-2" width="40" height="40" alt="@post.User.UserName's profile">
                                    <div>
                                        <div class="fw-bold text-primary">@post.User.UserName</div>
                                        <div class="text-muted small"><i class="bi bi-clock me-1"></i>@post.CreatedAt.ToString("g")</div>
                                    </div>
                                </div>
                                <div class="card-body py-3">
                                    <h5 class="card-title mb-2">@post.Title</h5>
                                    <p class="card-text">@post.Content</p>
                                    @if (!string.IsNullOrEmpty(post.ImagePath))
                                    {
                                        <div class="post-image mt-2">
                                            <img src="@post.ImagePath" alt="Post Image" class="img-fluid rounded">
                                        </div>
                                    }
                                        @if (post.PostFiles != null && post.PostFiles.Any())
                                    {
                                        <div class="mt-2 d-flex align-items-center">
                                            <i class="bi bi-paperclip text-muted me-1"></i>
                                                <span class="text-muted small">This post has @post.PostFiles.Count file@(post.PostFiles.Count != 1 ? "s" : "")</span>
                                        </div>
                                    }
                                </div>
                                <div class="card-footer bg-transparent d-flex justify-content-between py-3">
                                    <div class="d-flex align-items-center">
                                        <button class="btn btn-sm btn-outline-secondary me-3 d-flex align-items-center" data-post-id="@post.Id">
                                            <i class="bi bi-chat-dots me-1"></i> 
                                            <span class="comment-count" data-post-id="@post.Id">0</span>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger d-flex align-items-centers" data-post-id="@post.Id">
                                            <i class="bi bi-heart me-1"></i> 
                                            <span class="like-count" data-post-id="@post.Id">0</span>
                                        </button>
                                    </div>
                                    <button class="btn btn-sm btn-outline-primary view-details-btn">
                                        <i class="bi bi-eye me-1"></i> View Details
                                    </button>
                                </div>
                                <div class="comments-section px-4 py-3 bg-light border-top" id="comments-@post.Id" style="display: none;">
                                </div>
                            </div>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-center py-4">
                        <i class="bi bi-pencil-square text-muted d-block mb-2" style="font-size: 2rem;"></i>
                        <p class="text-muted mb-0">You haven't posted anything yet.</p>
                    </li>
                }
                </ul>
            </div>
        </div>
    </div>

    @Html.AntiForgeryToken()

    @section Scripts {
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"></script>
        <style>
            .hover-shadow:hover {
                box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
                transform: translateY(-3px);
            }
            .transition-all {
                transition: all 0.3s ease;
            }
            .bg-gradient {
                background: linear-gradient(to right, #f8f9fa, #e9ecef);
            }
            .post-item {
                cursor: pointer;
                transition: all 0.2s ease;
            }
            .post-item:hover {
                background-color: rgba(0,0,0,0.01);
            }
            .card-header {
                border-bottom: 1px solid rgba(0,0,0,.05);
            }
            #suggestionList {
                transition: transform 0.3s ease-in-out;
            }
        </style>
        <script>
            $.ajaxSetup({
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                }
            });

            $(document).ready(function () {
                // Setup infinite scrolling for suggested users
                function setupInfiniteScrolling() {
                    const suggestionList = document.getElementById('suggestionList');
                    const items = suggestionList.querySelectorAll('li');
                    const scrollLeftBtn = document.getElementById('suggestion-scroll-left');
                    const scrollRightBtn = document.getElementById('suggestion-scroll-right');
                    
                    if (items.length === 0) return;
                    
                    // Clone all items and append them to create infinite scroll effect
                    const itemsArray = Array.from(items);
                    itemsArray.forEach(item => {
                        const clone = item.cloneNode(true);
                        suggestionList.appendChild(clone);
                        
                        // Re-attach event listeners to clone's follow button
                        const followBtn = clone.querySelector('.follow-btn');
                        if (followBtn) {
                            const userId = followBtn.getAttribute('data-user-id');
                            $(followBtn).on('click', function(e) {
                                e.stopPropagation();
                                handleFollow(userId);
                            });
                        }
                    });
                    
                    // Calculate the width of one complete set of items
                    const itemWidth = 200; // Width in pixels of one item including margins
                    const totalWidth = itemsArray.length * itemWidth;
                    
                    let currentPosition = 0;
                    
                    function updateScroll() {
                        suggestionList.style.transform = `translateX(${-currentPosition}px)`;
                        
                        // If we scroll past all original items, reset position to create infinite effect
                        if (currentPosition >= totalWidth) {
                            // Jump back to beginning
                            currentPosition = currentPosition % totalWidth;
                            suggestionList.style.transition = 'none';
                            suggestionList.style.transform = `translateX(${-currentPosition}px)`;
                            // Force reflow
                            void suggestionList.offsetWidth;
                            suggestionList.style.transition = 'transform 0.3s ease-in-out';
                        }
                        
                        // If we scroll back before the start, jump to the equivalent position at the end
                        if (currentPosition < 0) {
                            currentPosition = totalWidth + (currentPosition % totalWidth);
                            suggestionList.style.transition = 'none';
                            suggestionList.style.transform = `translateX(${-currentPosition}px)`;
                            // Force reflow
                            void suggestionList.offsetWidth;
                            suggestionList.style.transition = 'transform 0.3s ease-in-out';
                        }
                    }
                    
                    // Click handlers for scroll buttons
                    scrollLeftBtn.addEventListener('click', () => {
                        currentPosition -= itemWidth * 3;
                        updateScroll();
                    });
                    
                    scrollRightBtn.addEventListener('click', () => {
                        currentPosition += itemWidth * 3;
                        updateScroll();
                    });
                    
                    // Function to handle follow button clicks
                    function handleFollow(userId) {
                        $.ajax({
                            url: "/Follows/FollowUser",
                            type: "POST",
                            data: { userIdToFollow: userId },
                            success: function () {
                                // Remove all instances of this user (original and clones)
                                $(`.follow-btn[data-user-id="${userId}"]`).closest('li').fadeOut(300, function() {
                                    $(this).remove();
                                });
                                // Update following posts
                                updateFollowingPosts();
                            },
                            error: function () {
                                alert("Error following user.");
                            }
                        });
                    }
                }
                
                // Initialize infinite scrolling
                setupInfiniteScrolling();

                $(".follow-btn").click(function () {
                    var btn = $(this);
                    var userId = btn.data("user-id");

                    $.ajax({
                        url: "/Follows/FollowUser",
                        type: "POST",
                        data: { userIdToFollow: userId },
                        success: function () {
                            $("#user-" + userId).fadeOut(300, function () {
                                $(this).remove();
                            });
                            // Call function to update following posts
                            updateFollowingPosts();
                        },
                        error: function () {
                            alert("Error following user.");
                        }
                    });
                });

                $("#newPostForm").submit(function (event) {
                    event.preventDefault(); // Prevent default form submission

                    var postContent = $("#postContent").val();
                    var postTitle = $("#postTitle").val(); // Get the title

                    $.ajax({
                        url: "/Posts/Create", // Or your appropriate controller/action for creating posts
                        type: "POST",
                        data: {
                            Content: postContent,
                            Title: postTitle
                        }, // Send title
                        success: function (newPost) {
                            // Assuming the server returns the newly created post data
                            if (newPost) {
                                // Create the HTML for the new post
                                var newPostHtml = `
                                    <li class="list-group-item mb-3 p-4 border rounded-lg shadow-md post-item" data-post-id="${newPost.postId}" style="cursor: pointer;">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong class="text-primary">${newPost.userName}</strong> - <small>${new Date(newPost.createdAt).toLocaleTimeString()} ${new Date(newPost.createdAt).toLocaleDateString()}</small>
                                                <p class="mt-2">${newPost.content}</p>
                                            </div>
                                        </div>
                                        <div class="mt-3 d-flex align-items-center">
                                            <span class="me-2">
                                                <i class="bi bi-chat-dots"></i> <span class="comment-count" data-post-id="${newPost.postId}">0</span> Comments
                                            </span>
                                            <span>
                                                <i class="bi bi-heart"></i> <span class="like-count" data-post-id="${newPost.postId}">0</span> Likes
                                            </span>
                                        </div>
                                        <div class="comments-section mt-3" id="comments-${newPost.postId}" style="display: none;">
                                        </div>
                                    </li>
                                `;

                                // Prepend the new post to the list
                                $("#currentUserPostsList").prepend(newPostHtml);

                                // Clear the textarea
                                $("#postContent").val("");
                                $("#postTitle").val(""); // Clear title

                                // Optionally update the "You haven't posted anything yet" message
                                if ($("#currentUserPostsList li").length === 1 && $("#currentUserPostsList li").text() === "You haven't posted anything yet.") {
                                    $("#currentUserPostsList li").remove();
                                }
                                //update following post
                                updateFollowingPosts();

                                // Re-bind the click event for the new post item
                                $('.post-item[data-post-id="' + newPost.postId + '"]').on('click', function() {
                                    var postId = $(this).data('post-id');
                                    window.location.href = '/Posts/Details/' + postId;
                                });

                                // Initialize like and comment counts for the newly added post
                                initializeLikeCounts();
                                initializeCommentCounts();

                            } else {
                                alert("Failed to add post.");
                            }
                        },
                        error: function () {
                            alert("Error creating post.");
                        }
                    });
                });

                function updateFollowingPosts() {
                    $.ajax({
                        url: "/Home/GetFollowingPosts", // New action to get following posts
                        type: "GET",
                        success: function (followingPosts) {
                            // Clear the current list
                            $("#followingPostsList").empty();
                            if (followingPosts && followingPosts.length > 0) {
                                $.each(followingPosts, function (index, post) {
                                    var postHtml = `
                                        <li class="list-group-item mb-3 p-0 border rounded-3 shadow-sm post-item" data-post-id="${post.postId}" style="cursor: pointer; transition: all 0.2s ease;">
                                            <div class="card border-0">
                                                <div class="card-header bg-transparent d-flex align-items-center border-0 pb-0 pt-3 px-4">
                                                    <img src="${post.profileImageUrl || '/defaults/images/default-avatar.png'}" class="rounded-circle me-2" width="40" height="40" alt="${post.userName}'s profile">
                                                    <div>
                                                        <div class="fw-bold text-primary">${post.userName}</div>
                                                        <div class="text-muted small"><i class="bi bi-clock me-1"></i>${new Date(post.createdAt).toLocaleTimeString()} ${new Date(post.createdAt).toLocaleDateString()}</div>
                                                    </div>
                                                </div>
                                                <div class="card-body px-4 py-3">
                                                    <h5 class="card-title mb-2">${post.title}</h5>
                                                    <p class="card-text mb-2">${post.content}</p>
                                                    ${post.imagePath ? `<div class="post-image mt-2 mb-2"><img src="${post.imagePath}" class="img-fluid rounded" alt="Post image"></div>` : ''}
                                                    ${post.fileCount > 0 ? `<div class="mt-2 d-flex align-items-center">
                                                        <i class="bi bi-paperclip text-muted me-1"></i>
                                                        <span class="text-muted small">This post has ${post.fileCount} file${post.fileCount !== 1 ? 's' : ''}</span>
                                                    </div>` : ''}
                                                </div>
                                                <div class="card-footer bg-transparent d-flex justify-content-between align-items-center px-4 py-3">
                                                    <div class="d-flex align-items-center">
                                                        <button class="btn btn-sm btn-outline-secondary me-3 d-flex align-items-center" data-post-id="${post.postId}" disabled>
                                                            <i class="bi bi-chat-dots me-1"></i> 
                                                            <span class="comment-count" data-post-id="${post.postId}">0</span>
                                                          
                                                        </button>
                                                                <button class="btn btn-sm btn-outline-danger d-flex align-items-center" data-post-id="${post.postId}" disabled>
                                                            <i class="bi bi-heart me-1"></i> 
                                                            <span class="like-count" data-post-id="${post.postId}">0</span>
                                                            
                                                        </button>
                                                    </div>
                                                    <button class="btn btn-sm btn-outline-primary view-btn">
                                                        <i class="bi bi-eye me-1"></i> View Post
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="comments-section px-4 py-3 bg-light border-top" id="comments-${post.postId}" style="display: none;">
                                            </div>
                                        </li>
                                    `;
                                    $("#followingPostsList").append(postHtml);

                                    // Re-bind the click event for the new post item
                                    $('.post-item[data-post-id="' + post.postId + '"]').on('click', function() {
                                        var postId = $(this).data('post-id');
                                        window.location.href = '/Posts/Details/' + postId;
                                    });

                                    // Override click behavior for comment and like buttons
                                    $(".comment-btn[data-post-id='" + post.postId + "']").on('click', function(e) {
                                        e.stopPropagation();
                                        var postId = $(this).data('post-id');
                                        var commentsSection = $('#comments-' + postId);
                                        if (commentsSection.is(':visible')) {
                                            commentsSection.slideUp();
                                        } else {
                                            commentsSection.slideDown();
                                            loadComments(postId);
                                        }
                                    });
                                });
                                // Initialize like and comment counts for the updated following posts
                                initializeLikeCounts();
                                initializeCommentCounts();
                            } else {
                                $("#followingPostsList").append('<li class="list-group-item">No recent posts from the users you are following.</li>');
                            }
                        },
                        error: function () {
                            alert("Failed to update following posts.");
                        }
                    });
                }

                // Event handler for comment button clicks (now just toggling visibility)
                $(document).on('click', '.comment-count', function (e) {
                    e.stopPropagation(); // Prevent the click from triggering the post item click
                    var postId = $(this).data('post-id');
                    var commentsSection = $('#comments-' + postId);

                    if (commentsSection.is(':visible')) {
                        commentsSection.slideUp(); // Hide comments section
                    } else {
                        commentsSection.slideDown(); // Show comments section
                        // Load comments here using AJAX (see next section)
                        loadComments(postId); // Call function to load comments
                    }
                });

                // Event handler for like count clicks (now just showing the count)
                $(document).on('click', '.like-count', function (e) {
                    e.stopPropagation(); // Prevent the click from triggering the post item click
                    // You can add functionality here to show who liked the post if needed
                    var postId = $(this).data('post-id');
                    // For now, we're just preventing the default button behavior
                });

                function loadComments(postId) {
                    var commentsSection = $('#comments-' + postId);
                    $.ajax({
                        url: `/Comments/GetComments?postId=${postId}`, // Adjust the URL as needed
                        type: "GET",
                        success: function (comments) {
                            commentsSection.empty(); // Clear existing comments
                            if (comments && comments.length > 0) {
                                $.each(comments, function (index, comment) {
                                    var commentHtml = `
                                        <div class="comment p-2 mb-2 border-bottom">
                                            <strong>${comment.userName}</strong>: ${comment.content}
                                            <small class="text-muted"> - ${new Date(comment.createdAt).toLocaleTimeString()} ${new Date(comment.createdAt).toLocaleDateString()}</small>
                                        </div>
                                    `;
                                    commentsSection.append(commentHtml);
                                });
                            } else {
                                commentsSection.append('<p class="text-muted">No comments yet.</p>');
                            }
                        },
                        error: function () {
                            alert("Failed to load comments.");
                        }
                    });
                }

                //scroll buttons
                const suggestionContainer = document.getElementById('suggestion-container');
                const suggestionList = document.getElementById('suggestionList');
                const scrollLeftBtn = document.getElementById('suggestion-scroll-left');
                const scrollRightBtn = document.getElementById('suggestion-scroll-right');
                const itemWidth = 250; // Width of each user suggestion item including margin

                scrollLeftBtn.addEventListener('click', () => {
                    suggestionContainer.scrollLeft -= itemWidth * 3; // Scroll by 3 items
                });

                scrollRightBtn.addEventListener('click', () => {
                    suggestionContainer.scrollLeft += itemWidth * 3; // Scroll by 3 items
                });

                // Add click event to the post items to redirect to details
                $(document).on('click', '.post-item', function() {
                    var postId = $(this).data('post-id');
                    window.location.href = '/Posts/Details/' + postId;
                });

                // Prevent default action for the now non-interactive buttons
                $(document).on('click', '.comment-btn, .like-btn', function(e) {
                    e.preventDefault();
                    e.stopPropagation(); // Stop the click from propagating to the parent li
                });

                // Initialize like counts on page load
                function initializeLikeCounts() {
                    $('.like-count').each(function() {
                        var postId = $(this).data('post-id');
                        var likeCountSpan = $(this); // Store the reference to the current element
                        $.ajax({
                            url: `/Reactions/GetLikeCount?postId=${postId}`, // Updated URL to ReactionsController
                            type: "GET",
                            success: function (data) {
                                likeCountSpan.text(data.likeCount); // Use the stored reference
                            },
                            error: function () {
                                console.error("Error fetching like count for post: " + postId);
                            }
                        });
                    });
                }

                // Initialize comment counts on page load (if you have an endpoint for this)
                function initializeCommentCounts() {
                    $('.comment-count').each(function() {
                        var postId = $(this).data('post-id');
                        var commentCountSpan = $(this); // Store the reference
                        $.ajax({
                            url: `/Comments/GetCommentCount?postId=${postId}`, // Your comment count endpoint
                            type: "GET",
                            success: function (data) {
                                commentCountSpan.text(data.commentCount); // Use the stored reference
                            },
                            error: function () {
                                console.error("Error fetching comment count for post: " + postId);
                            }
                        });
                    });
                }

